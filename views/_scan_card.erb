<article class="content-card" :class="{'in-progress': !scan.complete}">
  <%= erb :_scan_card_header %>
  <div x-show="!scan.complete" class="spinner-container">
    <div class="spinner"></div>
  </div>
  <div class="scan-card-content">
    <%= erb :_scan_card_unknowns %>
    <div class="recognized-shows">
      <template x-for="show in scan.updates" :key="show.aid">
        <%= erb :_scan_show %>
      </template>
    </div>
  </div>
</article>
