<div
  class="left-column"
  x-data
  :class="$store.lastUpdate.connection.isConnected ? 'connected' : 'disconnected'"
>
  <section
    class="request-scan"
    x-data="requestScanForm(<%= dry_run %>)"
    x-show="isTabActive('scans')"
  >
    <form @submit.prevent="submitForm($event)">
      <button id="start-scan" :disabled="$store.lastUpdate.scans.scanInProgress">Start Scan</button>
      <div x-show="$store.lastUpdate.scans.scanInProgress" class="spinner-container">
        <div class="spinner"></div>
      </div>
      <div class="checkbox-list">
        <label>
          <input type="checkbox" name="debug_mode" x-model="formData.debug_mode">
          Debug Mode
        </label>
        <label>
          <input type="checkbox" name="dry_run" x-model="formData.dry_run">
          Dry Run
        </label>
      </div>
    </form>
  </section>
  <section class="request-fetch" x-show="isTabActive('library')">
    <button
      id="fetch-library"
      :disabled="$store.library.isLoading"
      @click="$store.library.refetchLibrary()"
    >ReFetch Library</button>
  </section>
  <section class="latest-check" x-data>
    <div class="latest-check-header">
      <h2>Latest Check</h2>
      <p class="byline">
        <span>Checked</span>
        <span class="highlight-text" x-text="$store.lastUpdate.scans.timeSinceLastCheck"></span>
      </p>
    </div>
    <div x-show="$store.lastUpdate.scans.hasRun">
      <p>
        <strong class="label">Date:</strong>
        <span x-text="$store.lastUpdate.scans.scannedDate"></span>
      </p>
      <p>
        <strong class="label">Time:</strong>
        <span x-text="$store.lastUpdate.scans.scannedTime"></span>
      </p>
      <p>
        <strong class="label">Source:</strong>
        <span x-text="$store.lastUpdate.scans.reason"></span>
      </p>
      <p>
        <strong class="label">Result:</strong>
        <span x-text="$store.lastUpdate.scans.result"></span>
      </p>
    </div>
    <div x-show="!$store.lastUpdate.scans.hasRun">
      <p>
        <strong class="label">Status:</strong>
        <span>NEVER RUN</span>
      </p>
    </div>
  </section>
  <section class="latest-check" :class="{ 'is-stale': $store.lastUpdate.torrents.is_stale }" x-data>
    <div class="latest-check-header">
      <h2>Latest Torrent Sync</h2>
      <p class="byline">
        <span class="highlight-text" x-text="$store.lastUpdate.torrents.timeSinceLastSync"></span>
        <span x-show="$store.lastUpdate.torrents.is_stale">(STALE)</span>
      </p>
      <div x-show="$store.lastUpdate.torrents.sync_error_name">
        <p><span class="label" x-text="$store.lastUpdate.torrents.sync_error_name"></span></p>
        <p><span x-text="$store.lastUpdate.torrents.sync_error_msg"></span></p>
      </div>
    </div>
  </section>
  <section x-data>
    <h2 x-text="$store.lastUpdate.connection.connected ? 'Connected' : 'Disconnected'"></h2>
    <p x-show="$store.lastUpdate.connection.isConnected" class="byline">
      <span class="highlight-text">Last update</span>
      <span class="highlight-text" x-text="$store.lastUpdate.connection.timeSinceLastQueried"></span>
    </p>
    <p x-show="!$store.lastUpdate.connection.isConnected" class="byline">
      <span class="highlight-text" x-text="$store.lastUpdate.connection.timeSinceDisconnected"></span>
    </p>
  </section>
</div>
